# Copy to .env and adjust. All values are optional.

# Run the browser without a window (true) or visibly for debugging (false)
AVELO_HEADLESS=true

# Where the SQLite database lives
AVELO_DB_PATH=data/flights.db

# Airlines a scrape covers when --airlines is not given: XP (Avelo), F9 (Frontier). Frontier fares are
# stored but not shown in packages until Phase 3.
AVELO_AIRLINES=XP

# How many days ahead the scraper searches by default
AVELO_DAYS_AHEAD=60

# Min/max seconds to pause between page loads (polite, and avoids bot heuristics)
AVELO_DELAY_MIN=2.0
AVELO_DELAY_MAX=5.0

# Fare tier to record: standard (public) or subscription (Avelo PLUS member fare)
AVELO_FARE_TIER=standard

# Push alerts via ntfy.sh: install the ntfy app, subscribe to this topic name
AVELO_NTFY_TOPIC=

# Optional email alerts
AVELO_SMTP_HOST=
AVELO_SMTP_PORT=587
AVELO_SMTP_USER=
AVELO_SMTP_PASS=
AVELO_SMTP_TO=

# Home airports to search from (comma list; first is the "primary" one used for weather comparison)
AVELO_HOME_AIRPORTS=ILG,PHL,BWI

# Nightly job time (local)
AVELO_SCHEDULE_HOUR=3
AVELO_SCHEDULE_MINUTE=15

# Plus ROI meter: annual membership cost and value of free carry-on + seat per leg
AVELO_PLUS_ANNUAL_COST=99
AVELO_PLUS_VALUE_PER_LEG=50
